{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/development-guidelines.md",
    "docs/git-workflow.md",
    "docs/documentation-index.md",
    "docs/opencode-permissions.md"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git branch -D*": "ask",
      "git checkout --*": "ask",
      "Remove-Item*": "ask",
      "rm *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "Format-Volume*": "deny",
      "git config --global*": "ask"
    },
    "external_directory": "ask"
  }
}
